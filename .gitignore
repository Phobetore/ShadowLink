# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Test files
test-*.js
/*.test.js

# Git worktrees
.worktrees/

# Server state. Holds the workspace documents AND the server key
# (data/tokens.json, data/SHADOWLINK_ADMIN_CREDS.txt). Never commit it.
/data/
server/data/*
!server/data/.gitkeep
