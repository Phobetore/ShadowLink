# vscode
.vscode 

# Intellij
*.iml
.idea

# npm
node_modules

# Don't include the compiled main.js file in the repo.
# They should be uploaded to GitHub releases instead.
main.js

# Exclude sourcemaps
*.map

# obsidian
data.json

# Exclude macOS Finder (System Explorer) View States
.DS_Store

# Test files
test-*.js
/*.test.js

# Git worktrees
.worktrees/

# Server state. Holds the workspace documents AND the server key
# (data/tokens.json, data/SHADOWLINK_ADMIN_CREDS.txt). Never commit it.
/data/
server/data/*
!server/data/.gitkeep

# Internal design record: audit, specs, implementation plans.
# Working material, kept locally and out of the published repository.
docs/

# Where tools/mutate.mjs records the backups it holds, so a sweep can find one
# that a directory walk cannot reach — a worktree, a scratch copy, another clone.
tools/.mutation-ledger

# Originals held by tools/mutate.mjs while a mutation probe is applied.
# One should never outlive a run; `node tools/mutate.mjs sweep` finds any that do.
*.mutation-backup
